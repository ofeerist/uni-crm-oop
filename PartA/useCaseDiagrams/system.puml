@startuml
skinparam theme plain
skinparam packageStyle rectangle
skinparam roundcorner 10
skinparam shadowing false
skinparam defaultFontName "Segoe UI"

skinparam actor {
    BackgroundColor #FFEBEE
    BorderColor #C62828
}
skinparam usecase {
    BackgroundColor #FAFAFA
    BorderColor #37474F
    ArrowColor #546E7A
}

left to right direction

actor "User" as U
actor "TechSupportSpecialist" as TSS

rectangle "Tech Support Subsystem" {
    usecase "Create Tech Request" as CreateReq
    usecase "View New Requests" as ViewReqs
    usecase "Change Request Status" as ChangeStatus

    U -- CreateReq : <<createRequest()>>
    
    TSS -- ViewReqs : <<ViewNewRequestsCommand>>
    TSS -- ChangeStatus : <<ChangeRequestStatusCommand>>
}
@enduml