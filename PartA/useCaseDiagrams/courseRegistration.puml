@startuml
skinparam theme plain
skinparam packageStyle rectangle
skinparam roundcorner 10
skinparam shadowing false
skinparam defaultFontName "Segoe UI"

skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #000000
}

skinparam usecase {
    BackgroundColor #FAFAFA
    BorderColor #37474F
    ArrowColor #546E7A
    FontColor #000000
}

left to right direction

actor "User" as U
actor "Student" as S
actor "Employee" as E
actor "Teacher" as T
actor "Manager" as M
actor "TechSupport\nSpecialist" as TSS
actor "Researcher" as R

rectangle "University Management System" {

    usecase "Register for Course" as Register
    usecase "Transcript" as Transcript
    usecase "Course Management" as CourseMgmt
    usecase "Messages" as Messages
    usecase "Complaints" as Complaints
    usecase "Requests" as Requests
    usecase "Research Projects" as ResearchProjects
    usecase "Research Papers" as ResearchPapers
    usecase "H-Index & Top" as HIndex
    usecase "Journals" as Journals

    U -- Requests : <<createRequest()>>
    U -- Journals : <<SubscribeToJournalCommand>>
    U -- ResearchPapers : <<GetCitationCommand>>
    U -- HIndex : <<ViewTopResearcherCommand>>
    U -- ResearchProjects : <<becomeResearcher()>>

    E -- Messages : <<SendMessageCommand>>

    S -- Register : <<RegisterForCourseCommand>>
    S -- Transcript : <<ViewTranscriptCommand>>

    T -- Transcript : <<PutMarkCommand>>
    T -- Complaints : <<SendComplaintCommand>>

    M -- Register : <<ApproveStudentRegistrationCommand>>
    M -- CourseMgmt : <<AssignCourseToTeacherCommand>>
    M -- CourseMgmt : <<generateAcademicReport()>>

    TSS -- Requests : <<ViewNewRequestsCommand>>
    TSS -- Requests : <<ChangeRequestStatusCommand>>

    R -- ResearchPapers : <<PublishPaperCommand>>
    R -- ResearchPapers : <<PrintMyPapersCommand>>
    R -- HIndex : <<calculateHIndex()>>
}

@enduml