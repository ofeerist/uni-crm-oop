@startuml
skinparam theme plain
skinparam packageStyle rectangle
skinparam roundcorner 10
skinparam shadowing false
skinparam defaultFontName "Segoe UI"

skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
}
skinparam usecase {
    BackgroundColor #FAFAFA
    BorderColor #37474F
    ArrowColor #546E7A
}

left to right direction

actor "Student" as S
actor "Teacher" as T
actor "Manager" as M

rectangle "Academic Subsystem" {
    usecase "Register for Course" as Register
    usecase "Approve Student Registration" as ApproveReg
    usecase "Put Mark" as PutMark
    usecase "View Transcript" as ViewTranscript
    usecase "Assign Course to Teacher" as AssignCourse
    usecase "Generate Academic Report" as GenerateReport

    M -- ApproveReg : <<ApproveStudentRegistrationCommand>>
    M -- AssignCourse : <<AssignCourseToTeacherCommand>>
    M -- GenerateReport : <<generateAcademicReport()>>

    S -- Register : <<RegisterForCourseCommand>>
    S -- ViewTranscript : <<ViewTranscriptCommand>>

    T -- PutMark : <<PutMarkCommand>>
}
@enduml