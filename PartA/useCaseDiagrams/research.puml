@startuml
skinparam theme plain
skinparam packageStyle rectangle
skinparam roundcorner 10
skinparam shadowing false
skinparam defaultFontName "Segoe UI"

skinparam actor {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
}
skinparam usecase {
    BackgroundColor #FAFAFA
    BorderColor #37474F
    ArrowColor #546E7A
}

left to right direction

actor "User" as U
actor "Researcher\n(Decorator)" as R

rectangle "Research Subsystem" {
    usecase "Become Researcher" as BecomeRes
    usecase "Publish Paper" as Publish
    usecase "Print My Papers" as PrintPapers
    usecase "Calculate H-Index" as CalcHIndex
    usecase "Subscribe to Journal" as Subscribe
    usecase "Get Citation" as GetCitation
    usecase "View Top Researcher" as ViewTop

    U -- BecomeRes : <<becomeResearcher()>>
    U -- Subscribe : <<SubscribeToJournalCommand>>
    U -- GetCitation : <<GetCitationCommand>>
    U -- ViewTop : <<ViewTopResearcherCommand>>

    R -- Publish : <<PublishPaperCommand>>
    R -- PrintPapers : <<PrintMyPapersCommand>>
    R -- CalcHIndex : <<calculateHIndex()>>
}
@enduml