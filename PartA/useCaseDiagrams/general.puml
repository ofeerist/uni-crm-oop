@startuml
skinparam theme plain
skinparam packageStyle rectangle
skinparam roundcorner 10
skinparam shadowing false
skinparam defaultFontName "Segoe UI"

skinparam actor {
    BackgroundColor #FFF3E0
    BorderColor #EF6C00
}
skinparam usecase {
    BackgroundColor #FAFAFA
    BorderColor #37474F
    ArrowColor #546E7A
}

left to right direction

actor "Employee" as E
actor "Teacher" as T

rectangle "Communication Subsystem" {
    usecase "Send Message" as SendMsg
    usecase "Send Complaint" as SendComp

    E -- SendMsg : <<SendMessageCommand>>
    T -- SendComp : <<SendComplaintCommand>>
}
@enduml